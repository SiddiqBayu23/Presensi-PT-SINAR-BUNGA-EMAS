{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized HRD administrator role grant mapped by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the HRD administrator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Verified email address of the administrator"
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the administrator who granted this role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee HRIS master profile containing employment terms and private contact PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID or HRD-assigned employee record identifier"
        },
        "nik": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Company employee identification number (NIK)"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full employee name"
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Job title or position"
        },
        "division": {
          "type": "string",
          "pattern": "^.{2,32}$",
          "maxLength": 32,
          "description": "Company division"
        },
        "role": {
          "type": "string",
          "enum": ["hrd", "supervisor", "employee"],
          "maxLength": 16,
          "description": "Access role: hrd (admin), supervisor (team approval), employee (karyawan); immutable by non-admins"
        },
        "supervisorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "Direct supervisor UID (active supervisor in the same division) or empty for direct-to-HRD routing"
        },
        "shiftCode": {
          "type": "string",
          "enum": ["REGULER", "PAGI", "SIANG", "MALAM", "SECURITY24"],
          "maxLength": 16,
          "description": "Assigned work shift template"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Employee email address (PII)"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Employee mobile/WhatsApp number (PII)"
        },
        "address": {
          "type": "string",
          "maxLength": 240,
          "description": "Residential address (PII)"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Square profile photo as an image data URL (cropped 1:1, JPEG)"
        },
        "joinDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Employment start date YYYY-MM-DD"
        },
        "contractType": {
          "type": "string",
          "enum": ["PKWT", "PKO", "PKWTT"],
          "maxLength": 10,
          "description": "Employment contract category"
        },
        "contractEnd": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Contract expiration date YYYY-MM-DD"
        },
        "contractSigned": {
          "type": "boolean",
          "description": "Whether the digital contract has been e-signed"
        },
        "contractSignedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "WIB timestamp string when contract was signed"
        },
        "baseSalary": {
          "type": "number",
          "description": "Monthly base salary in IDR"
        },
        "positionAllowance": {
          "type": "number",
          "description": "Monthly position allowance in IDR"
        },
        "mealTransportAllowance": {
          "type": "number",
          "description": "Monthly meal and transport allowance in IDR"
        },
        "leaveQuota": {
          "type": "number",
          "description": "Remaining annual leave days"
        },
        "active": {
          "type": "boolean",
          "description": "Whether employee account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp"
        }
      },
      "required": [
        "uid",
        "nik",
        "name",
        "position",
        "division",
        "role",
        "shiftCode",
        "email",
        "phone",
        "address",
        "joinDate",
        "contractType",
        "contractEnd",
        "contractSigned",
        "contractSignedAt",
        "baseSalary",
        "positionAllowance",
        "mealTransportAllowance",
        "leaveQuota",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily clock-in and clock-out attendance log verified with GPS and live watermarked camera.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nik": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "division": {
          "type": "string",
          "enum": ["HRD", "Security", "Cleaning Service", "Operasional", "Keuangan"],
          "maxLength": 32
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "shiftCode": {
          "type": "string",
          "enum": ["REGULER", "PAGI", "SIANG", "MALAM", "SECURITY24"],
          "maxLength": 16
        },
        "clockInTime": {
          "type": "string",
          "maxLength": 12
        },
        "clockInPhotoVerified": {
          "type": "boolean"
        },
        "clockInLat": {
          "type": "number"
        },
        "clockInLng": {
          "type": "number"
        },
        "clockInAddress": {
          "type": "string",
          "maxLength": 200
        },
        "clockInDistanceMeters": {
          "type": "number"
        },
        "lateMinutes": {
          "type": "number"
        },
        "clockOutTime": {
          "type": "string",
          "maxLength": 12
        },
        "clockOutPhotoVerified": {
          "type": "boolean"
        },
        "clockOutLat": {
          "type": "number"
        },
        "clockOutLng": {
          "type": "number"
        },
        "clockOutAddress": {
          "type": "string",
          "maxLength": 200
        },
        "workMinutes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Tepat Waktu", "Terlambat", "Selesai", "Belum Pulang"],
          "maxLength": 24
        },
        "supervisorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "Supervisor UID at clock-in time (must match own employee doc supervisorUid) for supervisor read scoping"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nik",
        "employeeName",
        "division",
        "date",
        "shiftCode",
        "clockInTime",
        "clockInPhotoVerified",
        "clockInLat",
        "clockInLng",
        "clockInAddress",
        "clockInDistanceMeters",
        "lateMinutes",
        "clockOutTime",
        "clockOutPhotoVerified",
        "clockOutLat",
        "clockOutLng",
        "clockOutAddress",
        "workMinutes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
