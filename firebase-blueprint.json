  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted HRD administrator role registry keyed by Firebase Auth UID."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Master employee profiles and contact PII, accessible only to owner or HRD admin."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily GPS and live-camera verified attendance records per employee."
    },
    "/leaves/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Leave and sick permission submissions."
    },
    "/overtimes/{overtimeId}": {
      "schema": { "$ref": "#/entities/OvertimeRequest" },
      "description": "Overtime (SPL) requests."
    },
    "/shiftSwaps/{swapId}": {
      "schema": { "$ref": "#/entities/ShiftSwapRequest" },
      "description": "Shift swap requests."
    },
    "/exitClearances/{exitId}": {
      "schema": { "$ref": "#/entities/ExitClearanceRequest" },
      "description": "Offboarding exit clearance workflows."
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/ScheduleEntry" },
      "description": "Daily work shift schedules per employee."
    }
  }
}
